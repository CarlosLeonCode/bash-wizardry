# bash-wizardry Configuration
# Copy this file to ~/.config/bash-wizardry/config.env (recommended: it lives
# outside the repo, so updates never touch it) or to config.env in the repo.
# When both exist, the repo's config.env loads first and yours wins.

# Enable or disable specific modules
# Set to "true" to enable, "false" to disable.
BW_ENABLE_GIT=true
BW_ENABLE_NODE=true
BW_ENABLE_DOCKER=true
BW_ENABLE_RAILS=true
BW_ENABLE_DJANGO=true
BW_ENABLE_RUBY=true
BW_ENABLE_WORKSPACES=true
BW_ENABLE_DISCOVERY=true
BW_ENABLE_ENV=true

# Workspace Configuration
# Colon-separated list of paths where your projects live.
BW_WORKSPACE_ROOTS="$HOME/Dev"

# Git Configuration
# Space-separated branches that 'gclean' will never delete.
BW_GIT_PROTECTED_BRANCHES="main master develop dev stage staging"

# Agent & Safety
# How to behave when an AI coding agent (Claude Code, Codex, Cursor...) uses this shell.
# "auto": stay out of the way in non-interactive shells or when an agent variable is set.
# "1": always agent mode (only scripts/ on PATH). "0": always load everything.
# BW_AGENT_MODE=auto

# Space-separated environment variables that signal an AI agent (heuristic, not exhaustive).
# BW_AGENT_ENV_VARS="CLAUDECODE CLAUDE_CODE_ENTRYPOINT CODEX_SANDBOX CODEX_THREAD_ID CURSOR_AGENT GEMINI_CLI AI_AGENT"

# Space-separated aliases/functions allowed to shadow a real command, builtin or keyword.
# By default those are skipped at load time (run 'bw-help' to see which ones).
BW_ALLOW_OVERRIDE=""

# User Config & Modules (see docs/en/customization.md)
# Folder holding your config.env and modules/. Set it in the environment or in
# the repo's config.env (it decides where your config.env is read from).
# BW_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/bash-wizardry"

# Folder for your own modules: <name>.sh files, toggled with BW_ENABLE_<NAME>.
# A file named like a core module (e.g. git.sh) replaces that module.
# BW_USER_MODULES_DIR="$BW_CONFIG_HOME/modules"
