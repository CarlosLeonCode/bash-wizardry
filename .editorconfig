# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[*.{ts,tsx,js,mjs,json,css,yml,yaml}]
indent_style = space
indent_size = 2

# Shell: spaces only. No indent_size on purpose: existing files mix 2 and 4,
# so keep the style of the file you are editing.
[*.{sh,bash,bats}]
indent_style = space

# bwiz has no extension.
[scripts/bwiz]
indent_style = space
